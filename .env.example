NODE_ENV=development
PORT=4000

# NeonDB — use the pooled connection string for the app, the direct one for migrations.
DATABASE_URL=postgresql://user:password@host-pooler.neon.tech/yt_server?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host.neon.tech/yt_server?sslmode=require

# Auth
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-me-to-a-different-long-random-string
REFRESH_TOKEN_EXPIRES_IN=7d

# AWS S3
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
PRESIGNED_URL_EXPIRES_IN_SECONDS=900

# Upload limits
MAX_VIDEO_SIZE_MB=2048
UPLOAD_PART_SIZE_MB=8

# Bootstrap admin — consumed once by `npm run seed:admin`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please
SEED_ADMIN_NAME=Admin
